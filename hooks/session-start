#!/usr/bin/env bash
msg="<EXTREMELY_IMPORTANT>\\nYou have Project Kit installed. It provides 11 lifecycle skills for managing projects from idea to delivery. When the user asks to initialize project docs, break down requirements, create a blueprint, plan a change, execute plans, verify work, or check project status, use the corresponding project-kit skill (init / constitution / brief / blueprint / roadmap / plan / execute-plan / verify-plan / change / bug / status). The change skill routes every new requirement to Quick (zero documents) or Full (proposal/spec/plan three artifacts under docs/changes/CR-###-<slug>/). All skills work around a unified docs/ directory convention (see SKILL.md for the full structure).\\n</EXTREMELY_IMPORTANT>"

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$msg"
elif [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$msg"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$msg"
fi
exit 0
